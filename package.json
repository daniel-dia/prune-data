{
  "name": "prune-data",
  "version": "1.1.0",
  "description": "Dependency-free recursive data pruning utility.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-dia/prune-data.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "test": "node --test --test-isolation=process prune-data.test.js",
    "coverage": "node --test --test-isolation=process --experimental-test-coverage prune-data.test.js",
    "mutation": "stryker run",
    "prepack": "npm run build"
  },
  "keywords": [
    "payload",
    "prune",
    "recursive",
    "clean",
    "compact"
  ],
  "license": "MIT",
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@stryker-mutator/core": "^10.0.0",
    "typescript": "^5.9.3"
  }
}
