{
  "name": "context-lean",
  "version": "0.1.0",
  "description": "Dependency-free payload slimmer for compact agent context.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "test": "node --test --test-isolation=process context-slim.test.js",
    "coverage": "node --test --test-isolation=process --experimental-test-coverage context-slim.test.js",
    "mutation": "stryker run",
    "prepack": "npm run build"
  },
  "keywords": [
    "agent",
    "context",
    "toon",
    "clean",
    "compact"
  ],
  "license": "MIT",
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "typescript": "^5.9.3"
  }
}
